{
  "name": "cashmeretrace-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CashmereTrace MN REST API",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
